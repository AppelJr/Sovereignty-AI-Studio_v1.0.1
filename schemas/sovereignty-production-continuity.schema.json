{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://sovereignty-one.local/schemas/sovereignty-production-continuity.schema.json",
  "title":"Sovereignty AI Production Continuity",
  "description":"Evidence-backed production roadmap, checkpoints, handoffs and fail-closed execution governance.",
  "type":"object","additionalProperties":false,
  "required":["schema_version","project","baseline","architecture","governance","workstreams","production_gates","checkpoints","continuity","release"],
  "properties":{
    "schema_version":{"const":"1.1.0"},
    "project":{"type":"object","additionalProperties":false,"required":["name","owner","repository","protected_branch","production_branch"],"properties":{
      "name":{"const":"Sovereignty AI"},"owner":{"type":"string","minLength":1},
      "repository":{"const":"AppelJr/Sovereignty-AI-Studio_v1.0.1"},"protected_branch":{"const":"Collaboration"},"production_branch":{"const":"main"}}},
    "baseline":{"type":"object","additionalProperties":false,"required":["commit","readme_verified","working_tree_verified","baseline_integrity","signature_verified","source_ref"],"properties":{
      "commit":{"type":"string","pattern":"^[a-fA-F0-9]{7,40}$"},"readme_verified":{"type":"boolean"},"working_tree_verified":{"type":"boolean"},
      "baseline_integrity":{"enum":["PASS","FAIL","UNKNOWN"]},"signature_verified":{"type":"boolean"},"source_ref":{"type":"string","format":"uri"},
      "last_verified_at":{"type":["string","null"],"format":"date-time"}}},
    "architecture":{"type":"object","additionalProperties":false,"required":["smart_router","translation","watcher","helper","provider_lanes","heavy_judge","orchestrator","scar","merkle","repmhl","aimlul","revenue_gate"],"properties":{
      "smart_router":{"const":"DEVASSIST420_STAGE_1"},"translation":{"const":"DEVASSIST420_STAGE_2"},"watcher":{"const":"READ_ONLY"},"helper":{"const":"ADVISORY"},
      "provider_lanes":{"type":"array","items":{"enum":["GROK","GPT","CLAUDE"]},"uniqueItems":true,"minItems":3,"maxItems":3},
      "heavy_judge":{"const":"INDEPENDENT_VERDICT"},"orchestrator":{"const":"COORDINATION_ONLY"},"scar":{"const":"APPEND_ONLY_EVIDENCE"},
      "merkle":{"const":"INTEGRITY_PROOFS_NOT_AUTHORIZATION"},"repmhl":{"const":"VERIFY_BEFORE_RESUME"},"aimlul":{"const":"CORRECTION_DRIVEN_LEARNING"},"revenue_gate":{"const":"OWNER_POLICY_GATED"}}},
    "governance":{"type":"object","additionalProperties":false,"required":["owner_authorization","check_twice_execute_once","protected_baseline","fail_closed","automatic_promotion","unverified_code_output","approval_model","invariants"],"properties":{
      "owner_authorization":{"const":"REQUIRED"},"check_twice_execute_once":{"const":true},"protected_baseline":{"const":true},"fail_closed":{"const":true},
      "automatic_promotion":{"const":false},"unverified_code_output":{"const":"PROHIBITED"},"approval_model":{"const":"EXPLICIT_OWNER_ACCEPTANCE"},
      "invariants":{"type":"array","items":{"type":"string","minLength":1},"minItems":8,"uniqueItems":true}}},
    "workstreams":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/workstream"}},
    "production_gates":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/gate"}},
    "checkpoints":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/checkpoint"}},
    "continuity":{"type":"object","additionalProperties":false,"required":["current_checkpoint","resume_allowed","handoff_allowed","verified_state_required","pending_work"],"properties":{
      "current_checkpoint":{"type":["string","null"]},"resume_allowed":{"type":"boolean"},"handoff_allowed":{"type":"boolean"},"verified_state_required":{"const":true},
      "pending_work":{"type":"array","items":{"type":"string"}},
      "last_handoff":{"type":["object","null"],"additionalProperties":false,"required":["from","to","checkpoint_id","evidence_digest"],"properties":{
        "from":{"type":"string"},"to":{"type":"string"},"checkpoint_id":{"type":"string"},"evidence_digest":{"$ref":"#/$defs/digest"}}}}},
    "release":{"type":"object","additionalProperties":false,"required":["status","promotion_authorized","acceptance_evidence"],"properties":{
      "status":{"enum":["DEVELOPMENT","PRE_PRODUCTION","BLOCKED","READY_FOR_OWNER_REVIEW","PRODUCTION"]},
      "promotion_authorized":{"type":"boolean"},"acceptance_evidence":{"type":"array","items":{"type":"string"}},"owner_acceptance_ref":{"type":["string","null"]}}}
  },
  "$defs":{
    "digest":{"type":"string","pattern":"^(sha3-512:[a-fA-F0-9]{128}|sha256:[a-fA-F0-9]{64}|blake3:[a-fA-F0-9]{64})$"},
    "evidence":{"type":"object","additionalProperties":false,"required":["kind","reference","result","observed_at"],"properties":{
      "kind":{"enum":["repository_ref","commit","workflow_run","test_receipt","file","signature","manual_review"]},
      "reference":{"type":"string","minLength":1},"digest":{"anyOf":[{"$ref":"#/$defs/digest"},{"type":"null"}]},
      "result":{"enum":["PASS","FAIL","NOT_RUN","UNVERIFIED"]},"observed_at":{"type":"string","format":"date-time"}}},
    "workstream":{"type":"object","additionalProperties":false,"required":["id","name","status","evidence","remaining"],"properties":{
      "id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]*$"},"name":{"type":"string","minLength":1},
      "status":{"enum":["PASS","FAIL","IN_PROGRESS","BLOCKED","NOT_RUN","NOT_VERIFIED"]},
      "evidence":{"type":"array","items":{"$ref":"#/$defs/evidence"}},"remaining":{"type":"array","items":{"type":"string"}}}},
    "gate":{"type":"object","additionalProperties":false,"required":["id","name","status","mandatory","evidence"],"properties":{
      "id":{"type":"string"},"name":{"type":"string"},"status":{"enum":["PASS","FAIL","BLOCKED","NOT_RUN","STALE","UNPROVEN"]},
      "mandatory":{"type":"boolean"},"evidence":{"type":"array","items":{"$ref":"#/$defs/evidence"}}}},
    "checkpoint":{"type":"object","additionalProperties":false,"required":["id","sequence","created_at","status","completed","pending","blockers","verified_evidence","next_action","digest_algorithm","digest","previous_checkpoint_id","previous_digest","signature_status"],"properties":{
      "id":{"type":"string","minLength":1},"sequence":{"type":"integer","minimum":0},"created_at":{"type":"string","format":"date-time"},
      "status":{"enum":["ACTIVE","PAUSED","HANDED_OFF","COMPLETED","BLOCKED"]},
      "completed":{"type":"array","items":{"type":"string"}},"pending":{"type":"array","items":{"type":"string"}},"blockers":{"type":"array","items":{"type":"string"}},
      "verified_evidence":{"type":"array","items":{"$ref":"#/$defs/evidence"}},"next_action":{"type":"string","minLength":1},
      "digest_algorithm":{"const":"sha3-512"},"digest":{"$ref":"#/$defs/digest"},
      "previous_checkpoint_id":{"type":["string","null"]},"previous_digest":{"anyOf":[{"$ref":"#/$defs/digest"},{"type":"null"}]},
      "signature_status":{"enum":["UNSIGNED","SIGNED_UNVERIFIED","SIGNED_VERIFIED"]}}}
  },
  "allOf":[
    {"if":{"properties":{"release":{"properties":{"status":{"const":"PRODUCTION"}}}},"required":["release"]},
     "then":{"properties":{"baseline":{"properties":{"baseline_integrity":{"const":"PASS"}}},
       "production_gates":{"items":{"properties":{"status":{"const":"PASS"}}}},
       "workstreams":{"items":{"properties":{"status":{"const":"PASS"}}}},
       "release":{"properties":{"promotion_authorized":{"const":true},"owner_acceptance_ref":{"type":"string","minLength":1}}}}}},
    {"if":{"properties":{"release":{"properties":{"promotion_authorized":{"const":true}}}},"required":["release"]},
     "then":{"properties":{"release":{"required":["owner_acceptance_ref"]}}}}
  ]
}