{
  "schema_version": "1.0.0",
  "policy_version": "1.1.0",
  "storage_key": "sgk_provider_policy_v1",
  "owner_controlled": true,
  "unknown_provider": "DENY",
  "default_allow": ["xai", "local", "openai", "anthropic", "custom"],
  "default_block": ["google", "meta", "mistral"],
